---
---

<section id="inicio" class="relative overflow-hidden bg-white">
  <div
    class="pointer-events-none absolute inset-y-0 left-[18%] right-0 hidden bg-cover bg-no-repeat lg:block"
    style="background-image: url('/images/hero-bg.webp'); background-position: 15% center;"
    aria-hidden="true"
  ></div>

  <div class="container-page relative z-10 grid items-center gap-8 pb-12 pt-10 text-center sm:gap-10 sm:pb-16 sm:pt-12 lg:grid-cols-[1.05fr_1fr] lg:gap-6 lg:pb-20 lg:pt-14 lg:text-left">
    <div class="relative z-10 mx-auto flex w-full max-w-[548px] flex-col items-center lg:mx-0 lg:items-start">
      <a href="#inicio" class="mb-8 inline-block sm:mb-12 lg:mb-14" aria-label="Maxwell Growth App">
        <img
          src="/images/logo.webp"
          alt="Maxwell Growth App"
          width="275"
          height="30"
          class="mx-auto h-[20px] w-auto max-w-[180px] object-contain sm:h-[22px] sm:max-w-[205px] lg:mx-0 lg:object-left"
          loading="eager"
        />
      </a>

      <div class="flex w-max max-w-full flex-col items-center lg:items-start">
        <p class="text-[16px] font-semibold not-italic leading-snug tracking-[-0.035em] text-hero sm:text-[18px] sm:leading-none lg:text-[20px]">
          La App de <em class="italic">microlearning</em> que te ayudará a
        </p>

        <h1 class="hero-headline mt-[1px] w-full text-center whitespace-nowrap lg:text-left">
          ganar y crecer
        </h1>

        <p class="hero-pill mt-[5px] text-[20px] sm:text-[26px] lg:text-[30px]">
          en todas las áreas de tu vida
        </p>

        <p class="mt-5 max-w-[440px] text-[15px] font-normal leading-snug text-ink sm:text-[16px] sm:leading-none lg:text-[18px]">
          ¡Acelera tu desarrollo y desbloquea las habilidades<br />
          clave para alcanzar el éxito que deseas!
        </p>
      </div>

      <div class="mt-8 sm:mt-10">
        <img
          src="/images/app-of-the-day.webp"
          alt="Apple App of the Day"
          width="152"
          height="68"
          class="h-[44px] max-h-[50px] w-auto sm:h-[50px]"
          loading="eager"
        />
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-[300px] sm:max-w-[400px] lg:mx-0 lg:max-w-none lg:justify-self-end">
      <img
        src="/images/phones-hero.webp"
        alt="Capturas de Maxwell Growth App en iPhone"
        width="474"
        height="476"
        class="relative z-10 mx-auto h-auto w-full drop-shadow-[0_24px_48px_rgba(72,43,110,0.18)] lg:mr-[-1.5rem] lg:max-w-[520px] xl:max-w-[560px]"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
